<!--====== Header Start ======-->
<style>
    /* Deposit Button Styling */
    .header-deposit-btn {
        background: linear-gradient(95deg, #FB8466 3%, #BD5BD4 30%, #7473FA 65%, #53B2FA 103%);
        color: #ffffff !important;
        border: none;
        border-radius: 20px;
        padding: 5px 14px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
        transition: transform 0.1s ease, opacity 0.2s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .header-deposit-btn:hover {
        opacity: 0.9;
        color: #ffffff;
    }

    .header-deposit-btn:active {
        transform: scale(0.95);
    }
</style>

<header>
    <div class="header-top" style="background-color: #0e1011;">
        <div class="header-left">
            <a>
                <img src="../../Aviator/images/logo.svg" class="logo1" alt="Logo" />
            </a>
        </div>
        <div class="header-right d-flex align-items-center">
            
            <!-- Wallet Balance Display -->
            <a>
                <button class="deposite-btn d-flex align-items-center me-2" onclick="window.location.href='/wallet/recharge'">
                    <span class="material-symbols-outlined me-2"> payments </span>
                    <span class="me-2" id="header_wallet_balance">R$</span>
                </button>
            </a>

            <!-- 🔥 NEW DEPOSIT BUTTON 🔥 -->
            <button class="header-deposit-btn me-2" onclick="window.location.href='/wallet/recharge'">
                <span class="material-symbols-outlined f-18"> add_circle </span>
                DEPOSIT
            </button>

            <!-- Dropdown Menu -->
            <div class="btn-group">
                <button type="button"
                    class="btn btn-transparent dropdown-toggle p-0 d-flex align-items-center justify-content-center caret-none"
                    data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="material-symbols-outlined f-24 menu-icon text-white">
                        menu
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark profile-dropdown p-0">
                    <li class="profile-head d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <div>
                                <div class="profile-name mb-1"></div>
                                <div class="profile-name" id="username"></div>
                            </div>
                        </div>
                    </li>
                    
                    <li>
                        <a class="f-12 justify-content-between">
                            <div class="d-flex align-items-center">
                                <span class="material-symbols-outlined ico"> volume_mute </span>SOUND
                            </div>
                            <div>
                                <div class="form-check form-switch lg-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="sound" checked="true">
                                    <label class="form-check-label" for="sound"></label>
                                </div>
                            </div>
                        </a>
                    </li>

                    <li>
                        <a class="f-12 justify-content-between">
                            <div class="d-flex align-items-center">
                                <span class="material-symbols-outlined ico f-22"> music_note </span>MUSIC
                            </div>
                            <div>
                                <div class="form-check form-switch lg-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="music" checked="true">
                                    <label class="form-check-label" for="music"></label>
                                </div>
                            </div>
                        </a>
                    </li>

                    <li>
                        <a href="/home/" class="f-12 justify-content-between">
                            <div class="d-flex align-items-center">
                                <span class="material-symbols-outlined ico f-20"> flight_takeoff </span>Home
                            </div>
                        </a>
                    </li>

                    <li>
                        <a href="/wallet/recharge" class="f-12 justify-content-between">
                            <div class="d-flex align-items-center">
                                <span class="material-symbols-outlined ico f-20"> payments </span>DEPOSIT FUNDS
                            </div>
                        </a>
                    </li>

                    <li>
                        <a href="/wallet/withdrawal" class="f-12 justify-content-between">
                            <div class="d-flex align-items-center">
                                <span class="material-symbols-outlined ico f-20"> payments </span>WITHDRAW FUNDS FROM THE ACCOUNT
                            </div>
                        </a>
                    </li>

                    <li>
                        <a href="/wallet/rechargerecord" class="f-12 justify-content-between">
                            <div class="d-flex align-items-center">
                                <span class="material-symbols-outlined ico f-20"> payments </span>TRANSACTION HISTORY
                            </div>
                        </a>
                    </li>

                    <li>
                        <a href="/login" class="f-12 justify-content-between">
                            <div class="d-flex align-items-center">
                                <span class="material-symbols-outlined ico f-20"> logout </span>SIGN OUT
                            </div>
                        </a>
                    </li>

                    <% if (typeof ekyc !== 'undefined' && (ekyc === false || ekyc == 0)) { %>
                        <li>
                            <a href="/ekyc" class="f-12 justify-content-between">
                                <div class="d-flex align-items-center">
                                    <span class="material-symbols-outlined ico f-20"> verified </span>E-KYC
                                </div>
                            </a>
                        </li>
                    <% } %>
                    
                    <li class="divider"></li>
                </ul>
            </div>
        </div>
    </div>
</header>
<!--====== Header End ======-->