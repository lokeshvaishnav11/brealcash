<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="robots" content="noindex,nofollow">
    <meta content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" name="viewport">
    <title>realcash - Retirar Dinheiro</title>
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #030712;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding: 12px;
            font-size: 14px;
        }

        #app {
            width: 100%;
            max-width: 440px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* HEADER NAVBAR */
        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 4px;
            margin-bottom: 4px;
        }

        .navbar-left {
            cursor: pointer;
            font-size: 18px;
            color: #fff;
            width: 30px;
        }

        .navbar-title {
            font-size: 17px;
            font-weight: 600;
            text-align: center;
            flex: 1;
        }

        .sub-header-secure {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            color: #10b981;
            font-size: 12px;
            margin-top: -12px;
            margin-bottom: 8px;
        }

        /* BALANCE CARD */
        .balance-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .balance-label {
            color: #9ca3af;
            font-size: 13px;
        }

        .balance-val {
            font-size: 22px;
            font-weight: bold;
            color: #10b981;
            margin-top: 4px;
        }

        /* CARD CONTAINERS */
        .card-box {
            border-radius: 18px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            position: relative;
        }

        .card-pix {
            background: #061814;
            border: 1px solid #10b981;
        }

        .card-bank {
            background: #091224;
            border: 1px solid #1e3a8a;
        }

        /* CARD HEADERS */
        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .card-header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .card-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .pix-icon {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
        }

        .bank-icon {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
        }

        .card-title h3 {
            font-size: 15px;
            font-weight: 700;
        }

        .card-title p {
            font-size: 11px;
            color: #9ca3af;
        }

        .badge-tag {
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .badge-pix {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .badge-bank {
            background: rgba(59, 130, 246, 0.15);
            color: #3b82f6;
            border: 1px solid rgba(59, 130, 246, 0.3);
        }

        /* FORM INPUTS */
        .input-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .input-group label {
            font-size: 12px;
            color: #e5e7eb;
            font-weight: 500;
        }

        .input-box {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-box input, .input-box select {
            width: 100%;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 10px;
            padding: 12px;
            color: #fff;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s;
        }

        .card-pix .input-box input:focus {
            border-color: #10b981;
        }

        .card-bank .input-box input:focus, .card-bank .input-box select:focus {
            border-color: #3b82f6;
        }

        .input-icon-right {
            position: absolute;
            right: 12px;
            color: #10b981;
            font-size: 14px;
        }

        .row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        /* INFO NOTE BOX */
        .info-note {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 8px;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            color: #9ca3af;
        }

        /* BUTTONS */
        .btn-action {
            width: 100%;
            padding: 14px;
            border-radius: 10px;
            border: none;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .btn-pix {
            background: linear-gradient(90deg, #10b981, #059669);
            color: #fff;
        }

        .btn-bank {
            background: linear-gradient(90deg, #2563eb, #1d4ed8);
            color: #fff;
        }

        .btn-action:hover {
            opacity: 0.9;
        }

        /* FOOTER FEATURES */
        .footer-features {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 14px;
            padding: 14px 10px;
            margin-top: 5px;
        }

        .feat-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .feat-icon {
            font-size: 18px;
        }

        .feat-text h5 {
            font-size: 11px;
            font-weight: 700;
        }

        .feat-text p {
            font-size: 9px;
            color: #6b7280;
            margin-top: 2px;
        }

        /* SIDEBAR & TOAST */
        .sidebar {
            position: fixed;
            top: 0;
            right: -280px;
            width: 280px;
            height: 100%;
            background: #0f172a;
            z-index: 99999;
            transition: right 0.3s ease;
            padding: 20px;
        }

        .sidebar.open {
            right: 0;
        }

        .msg {
            position: fixed;
            left: 50%;
            top: 20px;
            transform: translateX(-50%);
            z-index: 9999;
        }

        .msg-content {
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            padding: 10px 18px;
            border-radius: 30px;
            font-size: 13px;
        }
    </style>
</head>

<body>
    <div id="app">
        <!-- Navbar -->
        <div class="navbar">
            <div class="navbar-left" onclick="location.href='/mian'">
                <i class="fa-solid fa-chevron-left"></i>
            </div>
            <div class="navbar-title">Adicionar método de pagamento</div>
            <div class="navbar-right"></div>
        </div>

        <div class="sub-header-secure">
            <i class="fa-solid fa-circle-check"></i>
            <span>Seus dados estão 100% seguros</span>
        </div>

        <!-- Win Wallet / Balance Section -->
        <div class="balance-card">
            <div>
                <div class="balance-label">Carteira de Retirada / Ganho</div>
                <div class="balance-val">R$ <span class="winWallet">0.00</span></div>
            </div>
            <i class="fa-solid fa-wallet" style="font-size: 24px; color: #10b981;"></i>
        </div>

        <!-- PIX CARD (Replaces UPI UI) -->
        <div class="card-box card-pix">
            <div class="card-header">
                <div class="card-header-left">
                    <div class="card-icon pix-icon">
                        <i class="fa-solid fa-shapes"></i>
                    </div>
                    <div class="card-title">
                        <h3>Adicionar Pix <span style="color: #10b981; font-weight: normal; font-size: 12px;">(Recomendado)</span></h3>
                        <p>Pagamento instantâneo</p>
                    </div>
                </div>
                <div class="badge-tag badge-pix">
                    <i class="fa-solid fa-bolt"></i> Instantâneo
                </div>
            </div>

            <!-- Input for Amount / Key -->
            <div class="input-group">
                <label>Valor da Retirada (R$)</label>
                <div class="input-box">
                    <input type="tel" inputmode="numeric" placeholder="Digite o valor" class="van-field__control" id="pix-amount">
                </div>
            </div>

            <div class="input-group">
                <label>Chave Pix (CPF, e-mail, telefone ou aleatória)</label>
                <div class="input-box">
                    <input type="text" placeholder="Ex: 000.000.000-00">
                    <div class="input-icon-right"><i class="fa-solid fa-shapes"></i></div>
                </div>
            </div>

            <div class="input-group">
                <label>Nome do titular da chave Pix</label>
                <div class="input-box">
                    <input type="text" placeholder="Ex: João da Silva">
                </div>
            </div>

            <div class="info-note">
                <i class="fa-regular fa-circle-question"></i>
                <span>Você pode usar CPF, e-mail, telefone ou chave aleatória</span>
            </div>

            <button class="btn-action btn-pix withdrawal-btn">
                Adicionar Pix
            </button>
        </div>

        <!-- BANK CARD -->
        <div class="card-box card-bank">
            <div class="card-header">
                <div class="card-header-left">
                    <div class="card-icon bank-icon">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>
                    <div class="card-title">
                        <h3>Adicionar conta bancária</h3>
                        <p>Transferência via banco</p>
                    </div>
                </div>
                <div class="badge-tag badge-bank">
                    <i class="fa-solid fa-shield-halved"></i> Seguro
                </div>
            </div>

            <div class="input-group">
                <label>Nome do banco</label>
                <div class="input-box">
                    <select style="color: #9ca3af;">
                        <option value="">Selecione o seu banco</option>
                        <option value="nubank">Nubank</option>
                        <option value="bradesco">Bradesco</option>
                        <option value="itau">Itaú</option>
                        <option value="caixa">Caixa Econômica</option>
                    </select>
                </div>
            </div>

            <div class="input-group">
                <label>Nome completo</label>
                <div class="input-box">
                    <input type="text" placeholder="Ex: João da Silva">
                </div>
            </div>

            <div class="input-group">
                <label>Número da conta</label>
                <div class="input-box">
                    <input type="text" placeholder="Ex: 00000-0">
                </div>
            </div>

            <div class="row-2">
                <div class="input-group">
                    <label>Agência</label>
                    <div class="input-box">
                        <input type="text" placeholder="Ex: 0000">
                    </div>
                </div>
                <div class="input-group">
                    <label>Dígito</label>
                    <div class="input-box">
                        <input type="text" placeholder="Ex: 0">
                    </div>
                </div>
            </div>

            <div class="info-note">
                <i class="fa-regular fa-circle-question"></i>
                <span>Verifique seus dados antes de salvar</span>
            </div>

            <button class="btn-action btn-bank m-t-10" onclick="location.href='/wallet/addBank'">
                Adicionar conta bancária
            </button>
        </div>

        <!-- FOOTER TRUST FEATURES -->
        <div class="footer-features">
            <div class="feat-item">
                <div class="feat-icon" style="color: #10b981;"><i class="fa-solid fa-shield-halved"></i></div>
                <div class="feat-text">
                    <h5>100% Seguro</h5>
                    <p>Seus dados protegidos</p>
                </div>
            </div>
            <div class="feat-item">
                <div class="feat-icon" style="color: #f59e0b;"><i class="fa-solid fa-bolt"></i></div>
                <div class="feat-text">
                    <h5>Rápido</h5>
                    <p>Depósitos e saques</p>
                </div>
            </div>
            <div class="feat-item">
                <div class="feat-icon" style="color: #8b5cf6;"><i class="fa-solid fa-headset"></i></div>
                <div class="feat-text">
                    <h5>Suporte 24/7</h5>
                    <p>Atendimento sempre</p>
                </div>
            </div>
        </div>

        <!-- Sidebar Section -->
        <div id="sidebar" class="sidebar">
            <div class="sidebar-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 10px">
                    <img src="/images/avatar.svg" alt="User" style="width: 35px; height: 35px; border-radius: 50%;" />
                    <div>
                        <div><%= typeof username !=='undefined' ? username : 'User' %></div>
                        <div style="font-size: 12px; color: #9ca3af">
                            R$ <%= (typeof money==='number' ) ? money.toLocaleString('pt-BR') : (money ? money : '0.00' ) %>
                        </div>
                    </div>
                </div>
                <div class="close-btn" id="closeSidebar" style="font-size: 24px; cursor: pointer;">×</div>
            </div>

            <a href="/wallet/recharge" class="menu-item" style="display: block; color: #fff; text-decoration: none; padding: 10px 0;">💰 DEPOSIT FUNDS</a>
            <a href="/wallet/withdrawal" class="menu-item" style="display: block; color: #fff; text-decoration: none; padding: 10px 0;">💵 WITHDRAW</a>
            <a href="/myProfile" class="menu-item" style="display: block; color: #fff; text-decoration: none; padding: 10px 0;">👤 PERSONAL DETAILS</a>
            <a href="/wallet/rechargerecord" class="menu-item" style="display: block; color: #fff; text-decoration: none; padding: 10px 0;">📄 TRANSACTION HISTORY</a>
            <a href="/home" id="openLoginPopupBtn" class="menu-item" style="display: block; color: #fff; text-decoration: none; padding: 10px 0;">🚪 SIGN OUT</a>

            <% if (typeof ekyc !=='undefined' && (ekyc==false || ekyc==0)) { %>
                <a href="/ekyc" class="menu-item" style="display: block; color: #fff; text-decoration: none; padding: 10px 0;">💰 E-KYC</a>
            <% } %>
        </div>
    </div>

    <!-- Extra Popup 1 -->
    <% if (extra===null && first==true) { %>
    <div id="withdrawal-popup">
        <div id="withdrawal-popup-content">
            <img id="recharge-now" src="/images/bextra.jpeg" style="width:100%;display:block;cursor:pointer;border-radius:8px;" onclick="window.location.href='/wallet/paynow/manual_upi?am=1499&extra=true'">
            <button id="blink-btn" onclick="window.location.href='/wallet/paynow/manual_upi?am=104&extra=true'">
                ⚡ RECHARGE NOW
            </button>
        </div>
    </div>

    <style>
    #withdrawal-popup {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,.75);
        display: flex; justify-content: center; align-items: center;
        z-index: 999999;
    }
    #withdrawal-popup-content { width: 79%; max-width: 420px; text-align: center; }
    #blink-btn {
        margin-top: 16px; width: 100%; padding: 14px; border: none; border-radius: 8px;
        background: #28a745; color: #fff; font-size: 18px; font-weight: 700; cursor: pointer;
        animation: pulse .8s infinite; box-shadow: 0 5px 15px rgba(40,167,69,.45);
    }
    @keyframes pulse {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(40,167,69,.7); }
        70% { transform: scale(1.08); box-shadow: 0 0 0 18px rgba(40,167,69,0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(40,167,69,0); }
    }
    </style>
    <% } %>

    <!-- Extra Popup 2 -->
    <% if (ekyc = 0 || ekyc == false) { %>
    <div id="withdrawal-popup">
        <div id="withdrawal-popup-content">
            <span id="close-popup">&times;</span>
            <img id="recharge-now" onclick="window.location.href ='/wallet/paynow/manual_upi?am=49&extra=false&ekyc=true'" style="height: 100%;width: 100%;" src="/images/bekyc.jpeg">
        </div>
    </div>
    <% } %>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="/js/client.js"></script>
    
    <script>
        $.ajax({
            type: "POST",
            url: "/api/webapi/check/Info",
            dataType: "json",
            success: function (response) {
                let user = response.userInfo[0];
                $('.winWallet').text(user.win_wallet);
            }
        });

        let isExtra = null;
        $.ajax({
            type: "GET",
            url: "/api/webapi/userme",
            dataType: "json",
            success: function (response) {
                const user = response.message;
            },
            error: function (err) {
                console.error("userme API error:", err);
            }
        });

        function alertMess(text, sic) {
            $('body').append(
                `<div class="msg"><div class="msg-content">${text}</div></div>`
            );
            setTimeout(() => {
                $('.msg').remove();
                if(sic) sic.removeClass('block-click');
            }, 1500);
        }

        /* Withdrawal Trigger */
        $('.withdrawal-btn').click(function (e) {
            e.preventDefault();
            let money = $('#pix-amount').val().trim();
            if (money) {
                $.ajax({
                    type: "POST",
                    url: "/api/webapi/withdrawal",
                    data: { money: money },
                    dataType: "json",
                    success: function (response) {
                        $(this).addClass('block-click');
                        if (response.status == true) {
                            $('.winWallet').text(response.win_wallet);
                            window.location.href = "/home";
                        }
                        alertMess(response.message, $(this));
                    }
                });
            } else {
                $(this).addClass('block-click');
                alertMess('Por favor, insira o valor', $(this));
            }
        });

        // Popup logic
        const withdrawalPopup = document.getElementById('withdrawal-popup');
        function showWithdrawalPopup() {
            if(withdrawalPopup) withdrawalPopup.style.display = "flex";
        }
        window.onload = showWithdrawalPopup;

        // Sidebar JS
        const menuToggle = document.getElementById("menuToggle");
        const sidebar = document.getElementById("sidebar");
        const closeSidebar = document.getElementById("closeSidebar");

        if (menuToggle && sidebar && closeSidebar) {
            menuToggle.addEventListener("click", (e) => {
                e.stopPropagation();
                sidebar.classList.add("open");
            });
            closeSidebar.addEventListener("click", () => sidebar.classList.remove("open"));
        }
    </script>
</body>

</html>