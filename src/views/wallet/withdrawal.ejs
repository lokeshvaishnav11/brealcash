<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="robots" content="noindex,nofollow">
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport">
    <title>RealCash - Retirar Dinheiro</title>
    
    <!-- Font Awesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #080c14;
            --card-bg: rgba(255, 255, 255, 0.03);
            --border-glow: rgba(255, 255, 255, 0.08);
            --primary-emerald: #10b981;
            --primary-blue: #3b82f6;
            --text-main: #ffffff;
            --text-sub: #9ca3af;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding: 12px;
            font-size: 14px;
        }

        #app {
            width: 100%;
            max-width: 440px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* HEADER NAVBAR */
        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 4px;
        }

        .navbar-left {
            cursor: pointer;
            font-size: 18px;
            color: #fff;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
        }

        .navbar-title {
            font-size: 17px;
            font-weight: 700;
            text-align: center;
            letter-spacing: 0.3px;
        }

        .sub-header-secure {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            color: var(--primary-emerald);
            font-size: 12px;
            margin-top: -10px;
            background: rgba(16, 185, 129, 0.08);
            padding: 6px 12px;
            border-radius: 20px;
            width: fit-content;
            margin-left: auto;
            margin-right: auto;
            border: 1px solid rgba(16, 185, 129, 0.2);
        }

        /* BALANCE CARD WITH GLASS EFFECT */
        .balance-card {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(15, 23, 42, 0.6) 100%);
            border: 1px solid rgba(16, 185, 129, 0.25);
            border-radius: 20px;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .balance-label {
            color: var(--text-sub);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-weight: 600;
        }

        .balance-val {
            font-size: 26px;
            font-weight: 800;
            color: #ffffff;
            margin-top: 4px;
        }

        /* AMOUNT INPUT BOX */
        .amount-box {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s ease;
        }

        .amount-box:focus-within {
            border-color: var(--primary-emerald);
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
        }

        .currency-symbol {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary-emerald);
        }

        .amount-box input {
            background: transparent;
            border: none;
            outline: none;
            color: #fff;
            font-size: 20px;
            font-weight: 700;
            width: 100%;
        }

        /* SAVED METHOD CONTAINER */
        .section-box {
            background: var(--card-bg);
            border: 1px solid var(--border-glow);
            border-radius: 20px;
            padding: 18px;
        }

        .section-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-sub);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 14px;
        }

        .saved-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .saved-item {
            background: linear-gradient(90deg, rgba(16, 185, 129, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 14px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .saved-item-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .saved-item-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: rgba(16, 185, 129, 0.2);
            color: var(--primary-emerald);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .saved-item .title {
            font-weight: 700;
            font-size: 14px;
            color: #fff;
        }

        .saved-item .sub {
            font-size: 11px;
            color: var(--text-sub);
            margin-top: 2px;
        }

        .add-method-btn {
            background: rgba(255, 255, 255, 0.03);
            border: 1px dashed rgba(255, 255, 255, 0.2);
            color: var(--primary-emerald);
            padding: 14px;
            border-radius: 14px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .add-method-btn:hover {
            background: rgba(16, 185, 129, 0.08);
            border-color: var(--primary-emerald);
        }

        /* WITHDRAW BUTTON */
        .btn-withdraw {
            width: 100%;
            padding: 16px;
            border-radius: 16px;
            border: none;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #fff;
            font-weight: 800;
            font-size: 16px;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.3);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-withdraw:active {
            transform: scale(0.98);
        }

        /* ADVANCED MODAL UI */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(3, 7, 18, 0.85);
            backdrop-filter: blur(12px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            padding: 16px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            display: flex;
            opacity: 1;
        }

        .modal-card {
            background: #0f172a;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 24px;
            width: 100%;
            max-width: 410px;
            padding: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            transform: translateY(20px);
            transition: transform 0.3s ease;
        }

        .modal-overlay.active .modal-card {
            transform: translateY(0);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .modal-header h3 {
            font-size: 17px;
            font-weight: 800;
        }

        .close-modal {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-sub);
        }

        .tab-switcher {
            display: flex;
            background: rgba(0, 0, 0, 0.4);
            border-radius: 12px;
            padding: 4px;
            margin-bottom: 18px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .tab-btn {
            flex: 1;
            padding: 10px;
            text-align: center;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            color: var(--text-sub);
            transition: all 0.2s ease;
        }

        .tab-btn.active {
            background: var(--primary-emerald);
            color: #fff;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 12px;
        }

        .input-group label {
            font-size: 11px;
            color: var(--text-sub);
            font-weight: 600;
            text-transform: uppercase;
        }

        .input-group input, .input-group select {
            width: 100%;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 12px 14px;
            color: #fff;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s;
        }

        .input-group input:focus, .input-group select:focus {
            border-color: var(--primary-emerald);
        }

        .btn-save {
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #fff;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            margin-top: 10px;
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
        }

        /* FOOTER FEATURES */
        .footer-features {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 14px 10px;
        }

        .feat-item { display: flex; align-items: center; gap: 8px; }
        .feat-text h5 { font-size: 11px; font-weight: 700; }
        .feat-text p { font-size: 9px; color: #6b7280; }

        /* TOAST MESSAGE */
        .msg { position: fixed; left: 50%; top: 25px; transform: translateX(-50%); z-index: 999999; }
        .msg-content { 
            background: #0f172a; 
            border: 1px solid rgba(255, 255, 255, 0.2); 
            color: #fff; 
            padding: 12px 22px; 
            border-radius: 30px; 
            font-size: 13px; 
            font-weight: 600;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        }
    </style>
</head>

<body>
    <div id="app">
        <!-- Navbar -->
        <div class="navbar">
            <div class="navbar-left" onclick="location.href='/mian'">
                <i class="fa-solid fa-chevron-left"></i>
            </div>
            <div class="navbar-title">Retirar Dinheiro</div>
            <div style="width: 36px;"></div>
        </div>

        <div class="sub-header-secure">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Seus dados estão 100% seguros</span>
        </div>

        <!-- Balance Section -->
        <div class="balance-card">
            <div>
                <div class="balance-label">Carteira de Retirada</div>
                <div class="balance-val">R$ <span class="winWallet">0.00</span></div>
            </div>
            <i class="fa-solid fa-wallet" style="font-size: 28px; color: var(--primary-emerald);"></i>
        </div>

        <!-- Withdrawal Amount Input -->
        <div class="amount-box">
            <span class="currency-symbol">R$</span>
            <input type="tel" inputmode="numeric" placeholder="Digite o valor da retirada" class="withdraw-amount-input">
        </div>

        <!-- Saved Payment Methods -->
        <div class="section-box">
            <div class="section-title">Método de Recebimento</div>
            <div class="saved-list list">
                <!-- Data loaded via JS -->
            </div>

            <div style="margin-top: 12px;">
                <button type="button" class="add-method-btn" id="openAddModal">
                    <i class="fa-solid fa-plus-circle"></i> Configurar / Alterar Dados Bancários
                </button>
            </div>
        </div>

        <!-- Withdraw Button -->
        <button type="button" class="btn-withdraw withdrawal-btn">
            Confirmar Retirada
        </button>

        <!-- FOOTER FEATURES -->
        <div class="footer-features">
            <div class="feat-item">
                <i class="fa-solid fa-shield-halved" style="color: var(--primary-emerald); font-size: 16px;"></i>
                <div class="feat-text"><h5>100% Seguro</h5><p>Criptografia</p></div>
            </div>
            <div class="feat-item">
                <i class="fa-solid fa-bolt" style="color: #f59e0b; font-size: 16px;"></i>
                <div class="feat-text"><h5>Rápido</h5><p>Via Pix</p></div>
            </div>
            <div class="feat-item">
                <i class="fa-solid fa-headset" style="color: #8b5cf6; font-size: 16px;"></i>
                <div class="feat-text"><h5>Suporte 24/7</h5><p>Atendimento</p></div>
            </div>
        </div>
    </div>

    <!-- ADVANCED MODAL -->
    <div class="modal-overlay" id="addModal">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Dados Bancários</h3>
                <div class="close-modal" id="closeAddModal">&times;</div>
            </div>

            <div class="tab-switcher">
                <div class="tab-btn active" id="tabPixBtn"><i class="fa-solid fa-shapes"></i> Chave PIX</div>
                <div class="tab-btn" id="tabBankBtn"><i class="fa-solid fa-building-columns"></i> Conta Bancária</div>
            </div>

            <!-- PIX FORM (Sends exact API Payload) -->
            <div id="pixForm">
                <div class="input-group">
                    <label>Tipo / Chave Pix (stk)</label>
                    <input type="text" id="pixKeyInput" placeholder="CPF, E-mail, Telefone ou Chave">
                </div>
                <div class="input-group">
                    <label>Nome do Titular (name_user)</label>
                    <input type="text" id="pixNameInput" placeholder="Ex: João da Silva">
                </div>
                <div class="input-group">
                    <label>E-mail do Titular (email)</label>
                    <input type="email" id="pixEmailInput" placeholder="exemplo@email.com">
                </div>
                <div class="input-group">
                    <label>Cidade / Estado (tinh)</label>
                    <input type="text" id="pixStateInput" placeholder="Ex: São Paulo / SP">
                </div>
                <button type="button" class="btn-save" id="savePixBtn" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                    Salvar Dados PIX
                </button>
            </div>

            <!-- BANK FORM (Sends exact API Payload) -->
            <div id="bankForm" style="display: none;">
                <div class="input-group">
                    <label>Nome do Banco (name_bank)</label>
                    <select id="bankSelect">
                        <option value="Nubank">Nubank</option>
                        <option value="Bradesco">Bradesco</option>
                        <option value="Itaú">Itaú</option>
                        <option value="Caixa Econômica">Caixa Econômica</option>
                        <option value="Banco do Brasil">Banco do Brasil</option>
                        <option value="Inter">Banco Inter</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>Nome do Titular (name_user)</label>
                    <input type="text" id="bankUserVal" placeholder="Ex: João da Silva">
                </div>
                <div class="input-group">
                    <label>Número da Conta / Agência (stk)</label>
                    <input type="text" id="bankAccVal" placeholder="Ex: Ag: 0001 C/C: 12345-6">
                </div>
                <div class="input-group">
                    <label>E-mail de Contato (email)</label>
                    <input type="email" id="bankEmailVal" placeholder="exemplo@email.com">
                </div>
                <div class="input-group">
                    <label>Estado / Cidade (tinh)</label>
                    <input type="text" id="bankStateVal" placeholder="Ex: SP">
                </div>
                <button type="button" class="btn-save" id="saveBankBtn">
                    Salvar Conta Bancária
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <script>
        function alertMess(text, element) {
            $('.msg').remove();
            $('body').append(`<div class="msg"><div class="msg-content">${text}</div></div>`);
            setTimeout(() => {
                $('.msg').remove();
                if (element) element.removeClass('block-click');
            }, 1800);
        }

        // Fetch & Load User Details
        function loadUserInfo() {
            $.ajax({
                type: "POST",
                url: "/api/webapi/check/Info",
                dataType: "json",
                success: function (response) {
                    if (response && response.userInfo && response.userInfo[0]) {
                        let user = response.userInfo[0];
                        $('.winWallet').text(user.win_wallet);
                    }

                    $('.section-box .list').empty();

                    if (response && response.datas && response.datas[0]) {
                        let data = response.datas[0];
                        let bankTitle = data.name_bank || "PIX Cadastrado";
                        let accDisplay = data.stk || data.phone;
                        let userHolder = data.name_user || "";

                        $('.section-box .list').append(`
                            <div class="saved-item">
                                <div class="saved-item-left">
                                    <div class="saved-item-icon">
                                        <i class="fa-solid fa-building-columns"></i>
                                    </div>
                                    <div>
                                        <div class="title">${bankTitle}</div>
                                        <div class="sub">${accDisplay} ${userHolder ? '• ' + userHolder : ''}</div>
                                    </div>
                                </div>
                                <i class="fa-solid fa-circle-check" style="color: var(--primary-emerald); font-size: 18px;"></i>
                            </div>
                        `);
                    } else {
                        $('.section-box .list').append(`
                            <div style="text-align: center; color: var(--text-sub); font-size: 12px; padding: 10px;">
                                Nenhuma conta bancária configurada ainda.
                            </div>
                        `);
                    }
                }
            });
        }

        $(document).ready(function() {
            loadUserInfo();
        });

        /* Modal Toggle Handlers */
        $('#openAddModal').click(() => {
            $('#addModal').addClass('active');
        });

        $('#closeAddModal').click(() => {
            $('#addModal').removeClass('active');
        });

        $('#tabPixBtn').click(function() {
            $(this).addClass('active');
            $('#tabBankBtn').removeClass('active');
            $('#pixForm').show();
            $('#bankForm').hide();
        });

        $('#tabBankBtn').click(function() {
            $(this).addClass('active');
            $('#tabPixBtn').removeClass('active');
            $('#bankForm').show();
            $('#pixForm').hide();
        });

        /* AJAX: Save PIX (Calls exact backend controller API) */
        $('#savePixBtn').click(function() {
            let $btn = $(this);
            let stk = $('#pixKeyInput').val().trim();
            let name_user = $('#pixNameInput').val().trim();
            let email = $('#pixEmailInput').val().trim();
            let tinh = $('#pixStateInput').val().trim();

            if (!stk || !name_user || !email || !tinh) {
                alertMess('Por favor, preencha todos os campos.', $btn);
                return;
            }

            $btn.addClass('block-click');

            $.ajax({
                type: "POST",
                url: "/api/webapi/addBank",
                data: {
                    name_bank: "PIX",
                    name_user: name_user,
                    stk: stk,
                    email: email,
                    tinh: tinh
                },
                dataType: "json",
                success: function(res) {
                    alertMess(res.message || 'Dados atualizados com sucesso!', $btn);
                    $('#addModal').removeClass('active');
                    loadUserInfo();
                },
                error: function() {
                    alertMess('Erro ao conectar ao servidor.', $btn);
                }
            });
        });

        /* AJAX: Save BANK (Calls exact backend controller API) */
        $('#saveBankBtn').click(function() {
            let $btn = $(this);
            let name_bank = $('#bankSelect').val();
            let name_user = $('#bankUserVal').val().trim();
            let stk = $('#bankAccVal').val().trim();
            let email = $('#bankEmailVal').val().trim();
            let tinh = $('#bankStateVal').val().trim();

            if (!name_bank || !name_user || !stk || !email || !tinh) {
                alertMess('Preencha todos os dados exigidos.', $btn);
                return;
            }

            $btn.addClass('block-click');

            $.ajax({
                type: "POST",
                url: "/api/webapi/addBank",
                data: {
                    name_bank: name_bank,
                    name_user: name_user,
                    stk: stk,
                    email: email,
                    tinh: tinh
                },
                dataType: "json",
                success: function(res) {
                    alertMess(res.message || 'Conta salva com sucesso!', $btn);
                    $('#addModal').removeClass('active');
                    loadUserInfo();
                },
                error: function() {
                    alertMess('Erro ao salvar dados bancários.', $btn);
                }
            });
        });

        /* Withdraw Trigger */
        $('.withdrawal-btn').click(function (e) {
            e.preventDefault();
            let money = $('.withdraw-amount-input').val().trim();
            let $btn = $(this);

            if (money) {
                $btn.addClass('block-click');
                $.ajax({
                    type: "POST",
                    url: "/api/webapi/withdrawal",
                    data: { money: money },
                    dataType: "json",
                    success: function (response) {
                        if (response.status == true) {
                            $('.winWallet').text(response.win_wallet);
                            window.location.href = "/home";
                        }
                        alertMess(response.message, $btn);
                    },
                    error: function() {
                        alertMess('Erro ao solicitar retirada', $btn);
                    }
                });
            } else {
                alertMess('Por favor, insira o valor', $btn);
            }
        });
    </script>
</body>

</html>